
---interface Props {
	title: string;
	description?: string;
}

const { title, description = "Бани и веники" } = Astro.props;
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	:root {
		--accent: 136, 58, 234;
	}
	html {
		font-family: system-ui, sans-serif;
		background: #13151a;
		color: white;
	}
</style>
