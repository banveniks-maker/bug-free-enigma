---
import Layout from '../layouts/Layout.astro';

const tariffs = [
  {
    name: "Базовый",
    price: "1 500 ₽/час",
    features: [
      "Русская баня на дровах",
      "Вместимость до 6 человек",
      "Душевая комната",
      "Комната отдыха",
      "Веники в подарок"
    ]
  },
  {
    name: "Премиум",
    price: "3 000 ₽/час",
    features: [
      "Финская сауна с парогенератором",
      "Вместимость до 10 человек",
      "Бассейн с подсветкой",
      "Караоке-система",
      "Комната отдыха с камином",
      "Чайная церемония"
    ],
    popular: true
  },
  {
    name: "VIP",
    price: "5 000 ₽/час",
    features: [
      "Комплекс бань: русская + финская",
      "Вместимость до 15 человек",
      "Джакузи и купель",
      "Бильярд",
      "Банкетный зал",
      "Услуги банщика",
      "Банный бар"
    ]
  }
];

const services = [
  {
    title: "Русская баня",
    description: "Традиционная баня на дровах с влажным паром 60–80 °C и вениками из берёзы и дуба.",
    icon: "🔥"
  },
  {
    title: "Финская сауна",
    description: "Сухой жар до 100 °C при влажности 10–15 %. Печь-каменка из ели и сосны.",
    icon: "♨️"
  },
  {
    title: "Хамам",
    description: "Турецкая баня: влажность 100 %, мраморные лежаки, пенный массаж и скрабирование.",
    icon: "🕌"
  },
  {
    title: "Инфракрасная сауна",
    description: "ИК-излучение прогревает тело на 4 см при комфортной температуре 45–60 °C.",
    icon: "🌡️"
  },
  {
    title: "Офуро (японская купель)",
    description: "Кедровая купель с горячей водой 40–45 °C и ароматическими маслами.",
    icon: "🛁"
  },
  {
    title: "Кедровая бочка",
    description: "Мини-сауна из сибирского кедра с целебным фитопаром. Голова снаружи.",
    icon: "🪵"
  },
  {
    title: "Соляная комната",
    description: "Гималайская розовая соль создаёт микроклимат моря. Помогает от аллергии.",
    icon: "🧂"
  },
  {
    title: "Бокс-сауна",
    description: "Индивидуальный бокс: тело нагревается снаружи, голова в прохладе.",
    icon: "📦"
  },
  {
    title: "Паровая комната",
    description: "Горячий пар 100 % влажности при 40–50 °C — идеально для дыхательной системы.",
    icon: "💨"
  },
  {
    title: "Купель с веером",
    description: "Полный банный цикл: веник → купель → холодное окунание → мёдный массаж.",
    icon: "🌊"
  },
  {
    title: "Сауна с бассейном",
    description: "Финская сауна + крытый бассейн с подсветкой. Для семьи и компании.",
    icon: "🏊"
  },
  {
    title: "Аромасауна",
    description: "Сауна с эфирными маслами (лаванда, эвкалипт, пихта) на камни печи.",
    icon: "🌿"
  }
];

const regions = [
  { name: "Анадырь", slug: "anadyr", region: "Чукотский АО" },
  { name: "Анапа", slug: "anapa", region: "Краснодарский край" },
  { name: "Архангельск", slug: "arhangelsk", region: "Архангельская область" },
  { name: "Астрахань", slug: "astrahan", region: "Астраханская область" },
  { name: "Балашиха", slug: "balashiha", region: "Московская область" },
  { name: "Барнаул", slug: "barnaul", region: "Алтайский край" },
  { name: "Белгород", slug: "belgorod", region: "Белгородская область" },
  { name: "Биробиджан", slug: "birobidzhan", region: "Еврейская АО" },
  { name: "Брянск", slug: "bryansk", region: "Брянская область" },
  { name: "Великие Луки", slug: "velikie-luki", region: "Псковская область" },
  { name: "Владивосток", slug: "vladivostok", region: "Приморский край" },
  { name: "Владикавказ", slug: "vladikavkaz", region: "Республика Северная Осетия" },
  { name: "Владимир", slug: "vladimir", region: "Владимирская область" },
  { name: "Волгоград", slug: "volgograd", region: "Волгоградская область" },
  { name: "Воронеж", slug: "voronezh", region: "Воронежская область" },
  { name: "Гатчина", slug: "gatchina", region: "Ленинградская область" },
  { name: "Геленджик", slug: "gelendzhik", region: "Краснодарский край" },
  { name: "Грозный", slug: "grozny", region: "Республика Чечня" },
  { name: "Дмитров", slug: "dmitrov", region: "Московская область" },
  { name: "Домодедово", slug: "domodedovo", region: "Московская область" },
  { name: "Екатеринбург", slug: "ekaterinburg", region: "Свердловская область" },
  { name: "Зеленоград", slug: "zelenograd", region: "Московская область" },
  { name: "Иваново", slug: "ivanovo", region: "Ивановская область" },
  { name: "Ижевск", slug: "izhevsk", region: "Удмуртская Республика" },
  { name: "Иркутск", slug: "irkutsk", region: "Иркутская область" },
