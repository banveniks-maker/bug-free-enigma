  { name: "Кемерово", slug: "kemerovo", region: "Кемеровская область" },
  { name: "Киров", slug: "kirov", region: "Кировская область" },
  { name: "Кострома", slug: "kostroma", region: "Костромская область" },
  { name: "Краснодар", slug: "krasnodar", region: "Краснодарский край" },
  { name: "Красноярск", slug: "krasnoyarsk", region: "Красноярский край" },
  { name: "Курск", slug: "kursk", region: "Курская область" },
  { name: "Липецк", slug: "lipetsk", region: "Липецкая область" },
  { name: "Ломоносов", slug: "lomonosov", region: "Ленинградская область" },
  { name: "Магадан", slug: "magadan", region: "Магаданская область" },
  { name: "Магнитогорск", slug: "magnitogorsk", region: "Челябинская область" },
  { name: "Махачкала", slug: "mahachkala", region: "Республика Дагестан" },
  { name: "Мегион", slug: "megion", region: "Ханты-Мансийский АО" },
  { name: "Москва", slug: "moskva", region: "Московская область" },
  { name: "Мурманск", slug: "murmansk", region: "Мурманская область" },
  { name: "Набережные Челны", slug: "naberezhnye-chelny", region: "Республика Татарстан" },
  { name: "Нарьян-Мар", slug: "naryan-mar", region: "Ненецкий АО" },
  { name: "Нижневартовск", slug: "nizhnevartovsk", region: "Ханты-Мансийский АО" },
  { name: "Нижний Новгород", slug: "nizhniy-novgorod", region: "Нижегородская область" },
  { name: "Новгород Великий", slug: "novgorod-velikiy", region: "Новгородская область" },
  { name: "Новокузнецк", slug: "novokuznetsk", region: "Кемеровская область" },
  { name: "Новороссийск", slug: "novorossiysk", region: "Краснодарский край" },
  { name: "Новосибирск", slug: "novosibirsk", region: "Новосибирская область" },
  { name: "Омск", slug: "omsk", region: "Омская область" },
  { name: "Оренбург", slug: "orenburg", region: "Оренбургская область" },
  { name: "Пенза", slug: "penza", region: "Пензенская область" },
  { name: "Пермь", slug: "perm", region: "Пермский край" },
  { name: "Петергоф", slug: "petergof", region: "Ленинградская область" },
  { name: "Петрозаводск", slug: "petrozavodsk", region: "Республика Карелия" },
  { name: "Петропавловск-Камчатский", slug: "petropavlovsk", region: "Камчатский край" },
  { name: "Подольск", slug: "podolsk", region: "Московская область" },
  { name: "Псков", slug: "pskov", region: "Псковская область" },
  { name: "Раменское", slug: "ramenskoe", region: "Московская область" },
  { name: "Ростов Великий", slug: "rostov-velikiy", region: "Ярославская область" },
  { name: "Ростов-на-Дону", slug: "rostov-na-donu", region: "Ростовская область" },
  { name: "Рыбинск", slug: "rybinsk", region: "Ярославская область" },
  { name: "Рязань", slug: "ryazan", region: "Рязанская область" },
  { name: "Самара", slug: "samara", region: "Самарская область" },
  { name: "Санкт-Петербург", slug: "sankt-peterburg", region: "Ленинградская область" },
  { name: "Саратов", slug: "saratov", region: "Саратовская область" },
  { name: "Севастополь", slug: "sevastopol", region: "Республика Крым" },
  { name: "Серпухов", slug: "serpukhov", region: "Московская область" },
  { name: "Симферополь", slug: "simferopol", region: "Республика Крым" },
  { name: "Смоленск", slug: "smolensk", region: "Смоленская область" },
  { name: "Сочи", slug: "sochi", region: "Краснодарский край" },
  { name: "Ставрополь", slug: "stavropol", region: "Ставропольский край" },
  { name: "Сургут", slug: "surgut", region: "Ханты-Мансийский АО" },
  { name: "Сыктывкар", slug: "syktyvkar", region: "Республика Коми" },
  { name: "Тамбов", slug: "tambov", region: "Тамбовская область" },
  { name: "Тверь", slug: "tver", region: "Тверская область" },
  { name: "Темрюк", slug: "temryuk", region: "Краснодарский край" },
  { name: "Тольятти", slug: "tolyatti", region: "Самарская область" },
  { name: "Томск", slug: "tomsk", region: "Томская область" },
  { name: "Тула", slug: "tula", region: "Тульская область" },
  { name: "Тюмень", slug: "tyumen", region: "Тюменская область" },
  { name: "Улан-Удэ", slug: "ulan-ude", region: "Республика Бурятия" },
  { name: "Ульяновск", slug: "ulyanovsk", region: "Ульяновская область" },
  { name: "Уфа", slug: "ufa", region: "Республика Башкортостан" },
  { name: "Хабаровск", slug: "habarovsk", region: "Хабаровский край" },
  { name: "Ханты-Мансийск", slug: "khanty-mansiysk", region: "Ханты-Мансийский АО" },
  { name: "Чебоксары", slug: "cheboksary", region: "Чувашская Республика" },
  { name: "Челябинск", slug: "chelyabinsk", region: "Челябинская область" },
  { name: "Чита", slug: "chita", region: "Забайкальский край" },
  { name: "Элиста", slug: "elista", region: "Республика Калмыкия" },
  { name: "Якутск", slug: "yakutsk", region: "Республика Саха (Якутия)" },
  { name: "Ялта", slug: "yalta", region: "Республика Крым" },
  { name: "Ярославль", slug: "yaroslavl", region: "Ярославская область" },
];
---

<Layout 
  title="Бани и Сауны по всей России - БанВеник.ру | Аренда бань, финских саун, хамамов"
  description="Лучшие бани и сауны России: русские бани на дровах, финские сауны, хамамы, бассейны. Аренда от 1500₽/час. Забронируйте онлайн!"
  keywords="баня, сауна, русская баня, финская сауна, хамам, аренда бани, баня с бассейном, баня на дровах, парная, банный комплекс"
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-amber-900 via-amber-800 to-amber-900 text-white py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-6xl font-bold mb-6">
          Лучшие бани и сауны по всей России
        </h1>
        <p class="text-xl md:text-2xl mb-8 text-amber-100">
          Традиционные русские бани, финские сауны и турецкие хамамы для вашего здоровья и отдыха
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#prices" class="bg-white text-amber-900 px-8 py-4 rounded-lg font-semibold text-lg hover:bg-amber-50 transition text-center">
            Выбрать тариф
          </a>
          <a href="tel:+79000000000" class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-white hover:text-amber-900 transition text-center">
            Позвонить сейчас
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="services" class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-4 text-gray-900">Наши услуги</h2>
      <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">
        Мы предлагаем широкий спектр банных услуг для вашего комфорта и здоровья
      </p>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {services.map(service => (
          <div class="bg-gradient-to-br from-amber-50 to-white p-6 rounded-xl shadow-md hover:shadow-xl transition">
            <div class="text-5xl mb-4">{service.icon}</div>
            <h3 class="text-xl font-bold mb-3 text-gray-900">{service.title}</h3>
            <p class="text-gray-600">{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Prices Section -->
  <section id="prices" class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-4 text-gray-900">Тарифы на аренду бани</h2>
      <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">
        Выберите подходящий тариф для незабываемого отдыха в бане или сауне
      </p>
      
      <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {tariffs.map(tariff => (
          <div class={`bg-white rounded-xl shadow-lg overflow-hidden ${tariff.popular ? 'ring-4 ring-amber-500 transform scale-105' : ''}`}>
            {tariff.popular && (
              <div class="bg-amber-500 text-white text-center py-2 font-semibold">
                Популярный
              </div>
            )}
            <div class="p-8">
              <h3 class="text-2xl font-bold mb-2 text-gray-900">{tariff.name}</h3>
              <div class="text-3xl font-bold text-amber-700 mb-6">{tariff.price}</div>
              <ul class="space-y-3 mb-8">
                {tariff.features.map(feature => (
                  <li class="flex items-start">
                    <svg class="w-5 h-5 text-green-500 mr-2 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    <span class="text-gray-700">{feature}</span>
                  </li>
                ))}
              </ul>
              <a href="#contact" class={`block text-center py-3 rounded-lg font-semibold transition ${tariff.popular ? 'bg-amber-600 text-white hover:bg-amber-700' : 'bg-gray-100 text-gray-900 hover:bg-gray-200'}`}>
                Забронировать
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-gray-900">Почему выбирают нас</h2>
      
      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <div class="text-center">
          <div class="bg-amber-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-10 h-10 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2 text-gray-900">Работаем круглосуточно</h3>
          <p class="text-gray-600">Бронирование в любое удобное время, 24/7</p>
        </div>
        
        <div class="text-center">
          <div class="bg-amber-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-10 h-10 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2 text-gray-900">Качество и чистота</h3>
          <p class="text-gray-600">Стерильная чистота после каждого визита</p>
        </div>
        
        <div class="text-center">
          <div class="bg-amber-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-10 h-10 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2 text-gray-900">Доступные цены</h3>
          <p class="text-gray-600">Оптимальное соотношение цены и качества</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regions Section -->
  <section class="py-20 bg-gradient-to-br from-amber-50 to-amber-100">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-4 text-gray-900">Бани по всей России</h2>
      <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">
        Наша сеть банных комплексов представлена в 94 городах России — от Калининграда до Анадыря
      </p>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 max-w-6xl mx-auto">
        {regions.map(region => (
          <a href={`/${region.slug}`} class="bg-white p-4 rounded-lg shadow-sm hover:shadow-md transition hover:bg-amber-50 block">
            <div class="flex items-center justify-between">
              <div class="flex items-center flex-1 min-w-0">
                <svg class="w-5 h-5 text-amber-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                </svg>
                <div class="flex-1 min-w-0">
                  <span class="text-gray-900 font-semibold block truncate">{region.name}</span>
                  <span class="text-gray-500 text-xs block truncate">{region.region}</span>
                </div>
              </div>
              <svg class="w-5 h-5 text-amber-600 ml-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-8">
        <p class="text-gray-600">
