---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Массаж в бане и сауне - Банвеник.ру">
  <div class="service-page">
    <header class="page-hero">
      <h1>💆 Массаж в бане и сауне</h1>
      <p>Найдите профессионального банного массажиста в вашем городе</p>
    </header>

    <section class="content-section">
      <div class="info-block">
        <h2>🌟 Польза банного массажа</h2>
        <div class="benefits-grid">
          <div class="benefit">
            <div class="icon">💪</div>
            <h3>Глубокая релаксация</h3>
            <p>Снятие мышечного напряжения в разогретом теле</p>
          </div>
          <div class="benefit">
            <div class="icon">🧘</div>
            <h3>Улучшение кровообращения</h3>
            <p>Усиление эффекта бани массажными техниками</p>
          </div>
          <div class="benefit">
            <div class="icon">✨</div>
            <h3>Омоложение кожи</h3>
            <p>Глубокое очищение и обновление клеток</p>
          </div>
          <div class="benefit">
            <div class="icon">🌿</div>
            <h3>Антицеллюлитный эффект</h3>
            <p>Медовый и веничный массаж</p>
          </div>
        </div>
      </div>

      <div class="services-list">
        <h2>Виды банного массажа</h2>
        <div class="service-cards">
          <div class="service-card">
            <h3>🌿 Веничный массаж</h3>
            <p>Традиционный русский массаж вениками</p>
            <p class="price">От 1,500₽</p>
          </div>
          <div class="service-card">
            <h3>🍯 Медовый массаж</h3>
            <p>Глубокое очищение и детокс</p>
            <p class="price">От 2,000₽</p>
          </div>
          <div class="service-card">
            <h3>💆 Классический массаж</h3>
            <p>Расслабляющий после парной</p>
            <p class="price">От 2,500₽</p>
          </div>
          <div class="service-card">
            <h3>🧊 Контрастный массаж</h3>
            <p>Чередование жара и холода</p>
            <p class="price">От 3,000₽</p>
          </div>
        </div>
      </div>

      <div class="cta-section">
        <h2>💼 Для массажистов и банщиков</h2>
        <p class="cta-text">Разместите свои услуги в каталоге и получайте заказы!</p>
        
        <div class="pricing-card premium">
          <h3>Размещение услуг массажа</h3>
          <div class="big-price">1,500₽<span>/месяц</span></div>
          <ul>
            <li>✅ Размещение в разделе "Массаж"</li>
            <li>✅ Ваши контакты и фото</li>
            <li>✅ Описание услуг и цены</li>
            <li>✅ Сертификаты и опыт работы</li>
            <li>✅ Отзывы клиентов</li>
            <li>✅ Показ в вашем городе</li>
          </ul>
          <a href="mailto:banveniks@gmail.com?subject=Размещение услуг массажа" class="cta-button">Разместить услуги</a>
        </div>

        <div class="example-block">
          <h3>📊 Что вы получите:</h3>
          <div class="stats-row">
            <div class="stat">
              <div class="stat-number">50+</div>
              <div class="stat-label">Новых клиентов/месяц</div>
            </div>
            <div class="stat">
              <div class="stat-number">100,000₽+</div>
              <div class="stat-label">Дополнительный доход</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="contact-section">
      <h2>📞 Контакты</h2>
      <p>Для размещения услуг массажа:</p>
      <a href="mailto:banveniks@gmail.com" class="email-link">banveniks@gmail.com</a>
    </section>
  </div>
</Layout>

<style>
.service-page {
  min-height: 100vh;
}

.page-hero {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 4rem 2rem;
  text-align: center;
}

.page-hero h1 {
  font-size: 3rem;
  margin-bottom: 1rem;
}

.content-section {
  max-width: 1200px;
  margin: 0 auto;
  padding: 4rem 2rem;
}

.info-block {
  margin-bottom: 4rem;
}

.info-block h2 {
  font-size: 2.5rem;
  text-align: center;
  margin-bottom: 3rem;
}

.benefits-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
}

.benefit {
  background: white;
  padding: 2rem;
  border-radius: 12px;
  text-align: center;
  box-shadow: 0 2px 12px rgba(0,0,0,0.1);
}

.icon {
  font-size: 3rem;
  margin-bottom: 1rem;
}

.benefit h3 {
  margin-bottom: 0.5rem;
}

.services-list {
  margin-bottom: 4rem;
}

.services-list h2 {
  font-size: 2.5rem;
  text-align: center;
  margin-bottom: 3rem;
}

.service-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
}

.service-card {
  background: white;
  padding: 2rem;
  border-radius: 12px;
  border: 2px solid #e0e0e0;
  transition: all 0.3s;
}

.service-card:hover {
  border-color: #667eea;
  transform: translateY(-5px);
}

.service-card h3 {
  margin-bottom: 1rem;
}

.price {
  color: #667eea;
  font-weight: bold;
  font-size: 1.2rem;
  margin-top: 1rem;
}

.cta-section {
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  padding: 3rem;
  border-radius: 16px;
  text-align: center;
}

.cta-text {
  font-size: 1.2rem;
  margin-bottom: 3rem;
}

.pricing-card {
  background: white;
  max-width: 600px;
  margin: 0 auto 3rem;
  padding: 3rem;
  border-radius: 16px;
  border: 3px solid #667eea;
  box-shadow: 0 4px 24px rgba(102, 126, 234, 0.2);
}

.big-price {
  font-size: 3rem;
  font-weight: bold;
  color: #667eea;
  margin: 1rem 0 2rem;
}

.big-price span {
  font-size: 1.2rem;
  color: #666;
}

.pricing-card ul {
  text-align: left;
  list-style: none;
  margin-bottom: 2rem;
}

.pricing-card li {
  padding: 0.8rem 0;
  border-bottom: 1px solid #f0f0f0;
  font-size: 1.1rem;
}

.cta-button {
  display: inline-block;
  padding: 1.2rem 3rem;
  background: #667eea;
  color: white;
  text-decoration: none;
  border-radius: 50px;
  font-size: 1.2rem;
  font-weight: bold;
  transition: all 0.3s;
}

.cta-button:hover {
  background: #5568d3;
  transform: translateY(-2px);
  box-shadow: 0 8px 16px rgba(102, 126, 234, 0.3);
}

.example-block {
  background: white;
  padding: 2rem;
  border-radius: 12px;
  margin-top: 2rem;
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
  margin-top: 2rem;
}

.stat {
  text-align: center;
}

.stat-number {
  font-size: 2.5rem;
  font-weight: bold;
  color: #667eea;
}

.stat-label {
  color: #666;
  margin-top: 0.5rem;
}

.contact-section {
  background: #f8f9fa;
  padding: 3rem 2rem;
  text-align: center;
}

.email-link {
  font-size: 1.5rem;
  color: #667eea;
  text-decoration: none;
  font-weight: bold;
}

@media (max-width: 768px) {
  .page-hero h1 {
    font-size: 2rem;
  }
  
  .stats-row {
    grid-template-columns: 1fr;
  }
}
</style>
